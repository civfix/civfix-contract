{
  "name": "@civfix/contract",
  "version": "0.72.0",
  "description": "civfix API contract: zod schemas and inferred types, the endpoints registry, AppError/ErrorCode, the typed API client, and the domain helpers both the backend and the apps run. Consumed from the registry by civfix-backend, civfix-admin and civfix-app.",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./avatar": {
      "import": {
        "types": "./dist/avatar.d.ts",
        "default": "./dist/avatar.js"
      },
      "require": {
        "types": "./dist/avatar.d.cts",
        "default": "./dist/avatar.cjs"
      }
    },
    "./datetime": {
      "import": {
        "types": "./dist/datetime.d.ts",
        "default": "./dist/datetime.js"
      },
      "require": {
        "types": "./dist/datetime.d.cts",
        "default": "./dist/datetime.cjs"
      }
    },
    "./geocode": {
      "import": {
        "types": "./dist/geocode.d.ts",
        "default": "./dist/geocode.js"
      },
      "require": {
        "types": "./dist/geocode.d.cts",
        "default": "./dist/geocode.cjs"
      }
    },
    "./host": {
      "import": {
        "types": "./dist/host/index.d.ts",
        "default": "./dist/host/index.js"
      },
      "require": {
        "types": "./dist/host/index.d.cts",
        "default": "./dist/host/index.cjs"
      }
    },
    "./markdown": {
      "import": {
        "types": "./dist/markdown/index.d.ts",
        "default": "./dist/markdown/index.js"
      },
      "require": {
        "types": "./dist/markdown/index.d.cts",
        "default": "./dist/markdown/index.cjs"
      }
    },
    "./ics": {
      "import": {
        "types": "./dist/ics/index.d.ts",
        "default": "./dist/ics/index.js"
      },
      "require": {
        "types": "./dist/ics/index.d.cts",
        "default": "./dist/ics/index.cjs"
      }
    },
    "./legal": {
      "import": {
        "types": "./dist/legal/index.d.ts",
        "default": "./dist/legal/index.js"
      },
      "require": {
        "types": "./dist/legal/index.d.cts",
        "default": "./dist/legal/index.cjs"
      }
    },
    "./legal-texts": {
      "import": {
        "types": "./dist/legal-texts/index.d.ts",
        "default": "./dist/legal-texts/index.js"
      },
      "require": {
        "types": "./dist/legal-texts/index.d.cts",
        "default": "./dist/legal-texts/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "legal:hash": "node scripts/legal-hash.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint --strict --pack npm && attw --pack . --profile node16",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "clean": "rimraf dist *.tsbuildinfo",
    "dev": "tsup --watch",
    "changeset": "changeset"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^10.14.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "rimraf": "^6.0.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.15"
  },
  "publishConfig": {
    "registry": "https://repo.civfix.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civfix/civfix-contract.git"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
